# 这个文件只放示例，不放真实密钥。
# 如需本地脚本读取，可复制为 .env；.env 已加入 .gitignore。

SPRING_PROFILES_ACTIVE=local

# HTTP 端口(D1):agent 默认 18080(内网服务,置于统一网关 :10010 之后);E2E 段用 18180。
# 不要再用 10010——那是统一网关的对外端口。
SERVER_PORT=18080

# MySQL / MariaDB for agent metadata
MYSQL_USERNAME=agent_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_URL='jdbc:mysql://localhost:3307/agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true'

# Redis for chat memory/session state
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=your_redis_password

# PgVector
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=dp
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=your_pgvector_password
PGVECTOR_TABLE=dp_embedding

# RAG 检索/引用阈值(F07 解耦):检索召回阈值(低)与引用展示阈值(高)分离。
# 检索低/无→广召回交 RRF+Rerank;展示高→只显高置信引用(带 top-1 兜底,永不清空)。按真实嵌入模型标定后再调。
RAG_RETRIEVAL_MIN_SCORE=0.0
RAG_CITATION_MIN_SCORE=0.75

# Flyway:版本化 agent MySQL schema。默认 false(本地无 MySQL 时走 H2 降级,不动 Flyway)。
# 仅在连得到真实 agent MySQL 库时设 true(如 docker-compose)。见 agent/src/main/resources/db/README.md。
FLYWAY_ENABLED=false

# Alibaba DashScope / Qwen. DASHSCOPE_API_KEY 同时启用 RAG 真实语义嵌入(F06);
# 未配置则 RAG 嵌入降级为 HashEmbeddingModel(哈希伪向量,无语义召回,仅本地跑通)。
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_STREAMING_MODEL=qwen-plus

# Resend mail tool
RESEND_API_KEY=your_resend_api_key
RESEND_FROM='InfiniteChat <noreply@img.infinitechat.nsnzd.cn>'
RESEND_API_URL='https://api.resend.com/emails'

# 安全 / 鉴权(P3 鉴权闭环:agent 已置于统一网关之后)
# CORS 白名单(逗号分隔的精确 origin;禁止 "*")。生产填真实前端域名。
AGENT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180
AGENT_CORS_ALLOW_CREDENTIALS=false
# 入网关身份强制(P3/B1):默认 true。缺失/非法网关注入的 X-User-Id 的非公开直连一律 401。
# 本地无网关联调:设 false 并自带可信 X-User-Id(model-config 等 admin 屏需 X-User-Roles 含 admin)。
# 注:X-User-Id / X-User-Roles 由统一网关注入(客户端伪造会被网关剥离),agent 不自验/签发 JWT。
AGENT_GATEWAY_ENFORCE_IDENTITY=true
# LLM 计费端点按主体限流(L9):每窗口每主体的最大请求数。超限 → 429 + Retry-After + code 42900。
AGENT_RATELIMIT_LLM_ENABLED=true
AGENT_RATELIMIT_LLM_CAPACITY=30
AGENT_RATELIMIT_LLM_WINDOW_SECONDS=60
# 高风险工具确认挑战令牌(F01):服务端一次性 token(绑定 userId/sessionId/工具指纹 + TTL,首选 Redis)。
# 客户端二次请求回传 confirmationToken(而非工具名)才放行;令牌一次性消费、不可伪造。
AGENT_TOOL_CHALLENGE_ENABLED=true
AGENT_TOOL_CHALLENGE_TTL_SECONDS=300
# Redis 不可用时:false=降级进程内内存存储(单实例,默认);true=fail-closed 拒绝高风险工具。多实例生产须接 Redis。
AGENT_TOOL_CHALLENGE_FAIL_CLOSED=false

# Optional feature toggles
MCP_ENABLED=false
MCP_BIGMODEL_SEARCH_ENABLED=false
MCP_TIME_ENABLED=false
WEB_SEARCH_ENABLED=false
