# ============================================================================
# InfiniteChat 端到端(E2E)测试环境 —— 隔离覆盖变量
# ----------------------------------------------------------------------------
# 用法：先 source 你现有的 chat.env(里面有真实 DB/Redis/COS/Resend 密钥)，
#       再 source 本文件覆盖“隔离相关”的少数变量。启动脚本已按此顺序处理：
#         set -a; . ~/projecta-runtime/chat.env; . <本文件>; set +a
# ----------------------------------------------------------------------------
# 复制为 e2e.env 后按需修改。e2e.env 不要提交(含可改的本地值)。
# ============================================================================

# ---- 身份/令牌(新鉴权模型必须)：E2E 用独立值，与线上区分 ----
JWT_SECRET_KEY=e2e-please-use-a-long-random-secret-at-least-32-bytes-xxxxxxxx
INTERNAL_SERVICE_TOKEN=e2e-internal-token-change-me

# ---- 数据库：独立库 InfiniteChat_e2e(同一 MariaDB 3307，不动线上库) ----
# MYSQL_USERNAME / MYSQL_PASSWORD 复用 chat.env，无需在此重复。
MYSQL_URL='jdbc:mysql://127.0.0.1:3307/InfiniteChat_e2e?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&allowPublicKeyRetrieval=true'

# ---- Redis：复用 6379，但用独立 DB 索引 5，键不与线上冲突 ----
# 注意：红包“过期事件退款(keyspace __keyevent@0__)”硬编码 db0，在 db5 下不触发；
#       但 @Scheduled 兜底扫描(查 DB)仍会退款，E2E 可验证退款的兜底路径。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=5

# ---- Nacos：复用 8848，但用独立命名空间 e2e(隔离服务发现，含 NettyService) ----
NACOS_SERVER_ADDR=127.0.0.1:8848
SPRING_CLOUD_NACOS_DISCOVERY_NAMESPACE=e2e

# ---- Kafka：独立 broker 127.0.0.1:9192(由 01-setup-infra.sh 启动)，与线上 9092 隔离 ----
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9192

# ---- 端口：整体 +100 段，避开线上 8080-8086/9000/10010 ----
GATEWAY_PORT=10110
AUTH_SERVICE_PORT=8182
CONTACT_SERVICE_PORT=8180
MESSAGING_SERVICE_PORT=8181
REALTIME_SERVICE_PORT=8183
NETTY_SERVICE_PORT=9100
OFFLINE_DATA_STORE_SERVICE_PORT=8185
MOMENT_SERVICE_PORT=8186

# ---- Spring profile：E2E 用 local(沿用 Auth 的 application-local.yml 习惯) ----
SPRING_PROFILES_ACTIVE=local

# ---- agent(J1：把 SB3 agent 纳入统一网关 E2E 栈;09-agent-e2e.sh 起,10-agent-smoke.sh 验) ----
# agent 监听 18080(context-path=/api);网关 agent 路由直连此地址(保留 /api 前缀)。
AGENT_SERVICE_PORT=18080
AGENT_GATEWAY_URI=http://127.0.0.1:18080
# 纯信任网关注入的 X-User-Id;true=直连缺身份 401(经网关注入才放行)。
AGENT_GATEWAY_ENFORCE_IDENTITY=true
# agent 隔离库(私有 MariaDB :3308);连不上则 agent 自动降级 H2(内存)。
AGENT_MYSQL_URL='jdbc:mysql://127.0.0.1:3308/agent_e2e?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true'
# LLM key:留空则聊天端点返回"模型未配置"(集成路径/鉴权注入仍可验);填真实 key 可验完整流式回复。
DASHSCOPE_API_KEY=

# ---- JVM(每个服务) ----
JAVA_OPTS='-Xms128m -Xmx512m'
