# 这个文件只放示例，不放真实密钥。
# 如需本地脚本读取，可复制为 .env；.env 已加入 .gitignore。

# Spring profile
SPRING_PROFILES_ACTIVE=local

# MySQL / MariaDB
MYSQL_USERNAME=infinite_chat
MYSQL_PASSWORD=your_mysql_password
MYSQL_URL='jdbc:mysql://localhost:3307/InfiniteChat?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC'

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=your_redis_password
REDISSON_ADDRESS=redis://localhost:6379

# Nacos / Kafka
NACOS_SERVER_ADDR=localhost:8848
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT 签名密钥（HS512，网关与各签发/验签方必须一致，建议 >= 32 字节）
JWT_SECRET_KEY=please_change_me_to_a_long_random_secret

# 服务间内部调用令牌（X-Internal-Token，各服务必须一致；默认仅供本地开发）
INTERNAL_SERVICE_TOKEN=infinite-chat-internal-dev-token

# Resend mail
RESEND_API_KEY=your_resend_api_key
RESEND_FROM='InfiniteChat <noreply@img.infinitechat.nsnzd.cn>'
RESEND_API_URL='https://api.resend.com/emails'

# Tencent Cloud COS / CDN
TencentCloudCosSecretId=your_tencent_cloud_cos_secret_id
TencentCloudCosSecretKey=your_tencent_cloud_cos_secret_key
TENCENT_CLOUD_COS_SECRET_ID=your_tencent_cloud_cos_secret_id
TENCENT_CLOUD_COS_SECRET_KEY=your_tencent_cloud_cos_secret_key
TENCENT_CLOUD_COS_REGION=ap-guangzhou
TENCENT_CLOUD_COS_BUCKET=infinite-chat-1306566676
TENCENT_CLOUD_COS_IMAGE_DOMAIN='https://img.infinitechat.nsnzd.cn'
TENCENT_CLOUD_COS_STATIC_DOMAIN='https://static.infinitechat.nsnzd.cn'
TENCENT_CLOUD_COS_CDN_DOMAIN='https://cdn.infinitechat.nsnzd.cn'
TENCENT_CLOUD_COS_ORIGIN_DOMAIN='https://cos.infinitechat.nsnzd.cn'
TENCENT_CLOUD_COS_PUBLIC_DOMAIN='https://img.infinitechat.nsnzd.cn'

# Cloudflare DNS for nsnzd.cn
CLOUDFLARE_DNS_TOKEN=your_cloudflare_dns_token
