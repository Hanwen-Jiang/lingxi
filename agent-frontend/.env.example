# agent-frontend (灵犀 / Lingxi) — Vite environment. Copy to .env.local and adjust.
# All vars are build/dev-time only and must be prefixed VITE_ to reach the app.

# Base URL the app calls. Default is the same-origin relative base "/api", which
# works behind the unified gateway in prod and the Vite dev proxy in dev.
# Set an absolute URL only to target a non-default backend directly.
# VITE_API_BASE_URL=/api

# Dev-only: where the Vite dev server proxies "/api" requests. Defaults to the
# agent backend's D1 port (18080). Point it at the legacy port (10010) or the
# unified gateway if the agent runs elsewhere.
# VITE_API_PROXY_TARGET=http://127.0.0.1:18080

# Dev-only: pretend the logged-in user has the "admin" role so the admin-only
# screens (D10: model-config + runtime context) render even without a real
# `roles` claim in the JWT (S3 ships that with the unified-JWT work). Never
# set this in a production build — server-side admin gating is the real check.
# VITE_DEV_ASSUME_ADMIN=true
